{
  "name": "grok-build-desktop",
  "version": "0.1.17",
  "description": "Windows desktop client for Grok Build",
  "main": "src/main.js",
  "author": "Grok Build contributors",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "test:backend": "node test/backend-smoke.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "dompurify": "3.4.12",
    "lucide": "0.468.0",
    "marked": "15.0.12",
    "qrcode": "1.5.4",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "build": {
    "appId": "ai.x.grok-build.desktop",
    "productName": "Grok Build",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Grok-Build-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grok Build"
    },
    "portable": {
      "artifactName": "Grok-Build-Portable-${version}-${arch}.${ext}"
    }
  }
}
